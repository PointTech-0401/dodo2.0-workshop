# Environment variables and local secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python caches and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python build artifacts
build/
dist/
*.egg-info/

# Local runtime data
runtime/*.json
!runtime/.gitkeep
*.log

# Optional browser checks pull happy-dom in via bun (see tests/browser/README.md).
# Each machine installs it locally; the workshop itself has no npm dependencies.
node_modules/
package.json
bun.lock
bun.lockb

# Editors
.idea/
.vscode/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Seeded design-canvas payloads (bundled editor, ~2.5MB each; regenerate with seed-canvas)
slides/workshop-1-listen-then-answer.html
slides/workshop-2-remember-and-stay-quiet.html

# Printed decks (a few MB each; regenerate with the Chrome command in slides/README.md)
slides/export/
