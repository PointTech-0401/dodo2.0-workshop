OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 只給命令列備援用（app.py lesson1 --offline）。瀏覽器客端沒有離線模式，
# 設成 1 不會讓聊天變成內建範例，只會讓「產生今日摘要」失敗。上課請保持 0。
DODO_WORKSHOP_OFFLINE=0
OPENAI_REALTIME_MODEL=gpt-realtime-2
# 與正式 dodo 專案相同的 OpenAI Realtime 聲線
OPENAI_REALTIME_VOICE=sage
# 沿用 dodo-workshop 1.0 的 OpenWeatherMap Key
WEATHER_API_KEY=
